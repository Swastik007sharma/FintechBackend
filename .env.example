# ── Better Auth ───────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your_secret_here
BETTER_AUTH_URL=http://localhost:3000

# ── Server ────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:3000
PORT=3000

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────
# Prisma Postgres (remote)
DATABASE_URL="postgres://<token>:<api-key>@db.prisma.io:5432/postgres?sslmode=require"

# Prisma Postgres (local dev via `prisma dev`)
# DATABASE_URL="prisma+postgres://localhost:51213/?api_key=<api_key>"
